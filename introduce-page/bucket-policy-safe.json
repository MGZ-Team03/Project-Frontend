{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObjectOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::speaktracker-landing/*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": [
            "0.0.0.0/0"
          ]
        }
      }
    },
    {
      "Sid": "DenyAllExceptRead",
      "Effect": "Deny",
      "Principal": "*",
      "NotAction": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::speaktracker-landing",
        "arn:aws:s3:::speaktracker-landing/*"
      ]
    }
  ]
}
